# Copy this file to .env and add the server-side Google AI Studio key.
GEMINI_API_KEY=your-google-ai-studio-key

# Optional Ollama configuration.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:0.6b
# Smaller context and output budgets keep short voice replies responsive.
OLLAMA_NUM_CTX=2048
# Number of relevant lesson chunks added to each voice prompt.
RAG_TOP_K=3

# Local Whisper speech-to-text. The model is downloaded once, then reused locally.
WHISPER_MODEL=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Greedy decoding is faster and sufficient for short English voice turns.
WHISPER_BEAM_SIZE=1

# Lightweight local JSONL conversation log. Set false to disable it.
SPEECH_LOG_ENABLED=true
SPEECH_LOG_FILE=speech_logs.jsonl
